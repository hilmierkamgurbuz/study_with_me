# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0
#
# This template is maintained from the github/gitignore repository
# and distributed under Creative Commons Zero v1.0 Universal license.

# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# unity-dev skill
.claude/preflight/
.claude/settings.local.json
.claude/hooks/__pycache__/

# Study With Me — local Gemini API key, never committed
/Assets/Config/GeminiApiConfig.asset
/Assets/Config/GeminiApiConfig.asset.meta

# Study With Me — OS / IDE noise
.DS_Store
**/.DS_Store
.idea/

# Study With Me — README source screenshots (published copies live in docs/screenshots/)
/readme_png/

# Study With Me — the Fruit Merge source project, kept locally for reference.
# The game itself is vendored into Assets/FruitMerge/ (that IS what game mode
# loads); this root folder is a second, unreferenced copy of the same content
# and Unity never sees it, since it sits outside Assets/.
/Fruit-Merge-main/

# Study With Me — unreferenced third-party content, excluded to keep the repo
# clonable. Every path below was checked against Room.unity/Game.unity by
# walking Unity GUID references transitively; none of them is reachable.
# Nothing here is deleted locally — it is only kept out of the repository.

# Trip Hop Music: DanceModeController.tracks wires exactly two of the ten
# tracks. The other eight are 251 MB of uncompressed WAV nothing points at.
/Assets/Trip Hop Music/Eroded World.wav*
/Assets/Trip Hop Music/Like a Machine.wav*
/Assets/Trip Hop Music/Mysterious Fighter.wav*
/Assets/Trip Hop Music/Night Racer.wav*
/Assets/Trip Hop Music/Preach.wav*
/Assets/Trip Hop Music/Ripped.wav*
/Assets/Trip Hop Music/They Say.wav*
/Assets/Trip Hop Music/Whisper in the Dark.wav*

# LowPolyLivingRoomPack: all 158 of its GUIDs, zero hits in Room.unity. The
# room was built from LowPolyBoy + ZNS3D instead; blueprint.md still names
# this pack, which is stale rather than accurate.
/Assets/LowPolyLivingRoomPack/

# Vendor demo scenes and the character art belonging to characters this
# project does not use (Chloe is built from Assets/Art/Character/deneme.fbx,
# not from the pack's rigged characters — see decisions.md D-010).
/Assets/ZNS3D/FREE_STYLIZED_GAMEROOM_PACK/SCENES/
/Assets/ZNS3D/FREE_STYLIZED_GAMEROOM_PACK/TEXTURES/*_Face_Alpha.png*
/Assets/LowPolyBoy/FreeStylizedBedRoom/DemoScene/
/Assets/PolyOne/Cartoon Dog, Cat/Scene/
